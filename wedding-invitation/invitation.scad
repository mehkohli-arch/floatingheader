// ============================================================================
//  Lace envelope-fold invitation: Meher Kohli & Marlon Oras Hidalgo
//  Valley of Fire, Las Vegas, Nevada · May 20, 2027
//
//  One sheet that folds into its own envelope (about 6.5 x 3.5 in, the size of
//  a #6 3/4 envelope) and opens into a full 6.5 x 9.8 in page:
//
//        /\        P3  pointed top flap (monogram inside, wax seal outside)
//       /  \
//      |    |  ── fold 2
//      |    |      P2  names, date and venue
//      |    |  ── fold 1
//      |    |      P1  bottom panel: corner slits hold a 5 x 2.5 in paper card
//      |____|
//
//  To close: fold P1 up, then fold P3 down over it. Both folds are living
//  hinges (the first two printed layers). The inside of the page prints
//  face-down on the bed, so the lettering is engraved into the smooth face.
//
//  Build: tools/build.sh   Previews: tools/previews.sh
//  part = "layer_*" / "inlay" / "2d_*"  (see the bottom of the file)
// ============================================================================

use <fonts/GreatVibes-Regular.ttf>
use <fonts/Cinzel.ttf>
include <fonts/cinzel_widths.scad>   // generated by tools/glyph_widths.py

part = "2d_inside";

// ---------------- wording ----------------
name_1    = "Meher Kohli";
name_2    = "Marlon Oras Hidalgo";
initial_1 = "M";  initial_2 = "M";   // monogram initials
line_top  = "PLEASE JOIN US FOR THE WEDDING OF";
line_date = "MAY 20, 2027";
line_loc  = "VALLEY OF FIRE · LAS VEGAS, NEVADA";

script_font = "Great Vibes";
caps_font   = "Cinzel";

// ---------------- page ----------------
PW  = 165;      // page width = folded envelope width (6.5 in)
P1h = 86;       // bottom panel
P2h = 90;       // middle panel = folded envelope height (3.5 in)
P3h = 63;       // top flap, to the tip
P3rect = 0;     // straight part of the flap before the point
g1  = 2.5;      // hinge gaps; fold 2 is wider because it wraps over P1
g2  = 5.0;
T       = 1.2;  // sheet thickness
hinge_t = 0.4;  // living hinge = first two layers (0.2 mm each)
deboss  = 0.6;  // engraving depth on the inside face
text_grow = 0.16;   // keeps the small capitals printable

y1a = 0;          y1b = P1h;
y2a = P1h + g1;   y2b = y2a + P2h;
y3a = y2b + g2;   y3r = y3a + P3rect;   y3t = y3a + P3h;
Ytot = y3t;
seal_r = 13.5;  seal_c = [0, y3t - seal_r];   // lace medallion at the flap tip

// paper details card, tucked into four corner slits on P1
insert_w = 127;  insert_h = 63.5;   // 5 x 2.5 in
slit_d = 8;      // how far each corner tucks in

// ---------------- lace ----------------
// Chantilly-style border along every outer edge (edge-local units, mm):
//   0 .. sr        scallops, each holding an openwork fan, picots on the rim
//   sr .. lace_w   fine net with garland swags, open flowers, leaves and buds
//   lace_w         solid cordonnet line, then a beaded row of tiny holes
sr      = 5.2;       // scallop radius (= scallop depth)
lace_w  = 17;        // total border width
unit    = 10.8;      // scallop pitch (stretched to fit each edge exactly)
rose_r  = 8;         // corner rosettes
hex_p = 2.25;  hex_hole = 1.62;   // ~0.63 mm threads
fold_rim = 2.5;                   // solid strip along each fold
insert_cy = (lace_w + y1b) / 2 + 0.3;

$fn = 36;

// ============================================================================
//  helpers
// ============================================================================
module stroke(pts, w=0.7) for (i=[0:len(pts)-2]) hull() {
    translate(pts[i]) circle(d=w, $fn=10); translate(pts[i+1]) circle(d=w, $fn=10);
}
module leaf(l=3, w=1.3) {
    r = (l*l/4 + w*w/4) / w;
    translate([l/2,0]) intersection() {
        translate([0, -(r - w/2)]) circle(r=r, $fn=48);
        translate([0,  (r - w/2)]) circle(r=r, $fn=48);
    }
}
module blossom(r=2.5, n=5, hole=true) difference() {
    union() for (a=[0:360/n:359]) rotate(a+90) translate([r*0.5,0]) scale([r*0.55, r*0.37]) circle(1, $fn=24);
    if (hole) circle(d=r*0.36, $fn=12);
}
cord = 0.65;
module lace_blossom(r, n=5, inner=false) {
    if (!inner) blossom(r, n, false);
    else difference() {
        for (a=[0:360/n:359]) rotate(a+90) offset(-cord) translate([r*0.5,0]) scale([r*0.55, r*0.37]) circle(1, $fn=24);
        circle(r=r*0.33, $fn=20);
    }
}
module edge_vine(L, inner=false) {        // along x, centred, symmetric about y=0
    half = 7.2;
    n = 2*floor((L - 2*16) / (2*half));
    x0 = -n*half/2;  amp = 1.5;
    if (n > 0) {
        if (!inner) stroke([for (x=[x0-1.5:0.6:-x0+1.5]) [x, amp*sin((x-x0)*180/half)]], 0.7);
        for (k=[0:n-1]) {
            s = (k%2==0) ? 1 : -1;
            translate([x0 + (k+0.5)*half, s*(amp+0.8)]) rotate(k*23) lace_blossom(3.2, 5, inner);
            if (!inner) {
                translate([x0 + k*half, 0]) rotate(s>0 ? 125 : -55) leaf(2.6, 1.05);
                translate([x0 + (k+1)*half - 0.2, 0]) rotate(s>0 ? -125 : 55) leaf(2.2, 0.95);
            }
        }
    }
}
module corner_motif(inner=false) {
    lace_blossom(4.0, 5, inner);
}
module net_holes(x0, x1, y0, y1) {
    dy = hex_p*sqrt(3)/2;
    for (j=[floor(y0/dy)-1:ceil(y1/dy)+1], i=[floor(x0/hex_p)-1:ceil(x1/hex_p)+1])
        translate([i*hex_p + (abs(j)%2)*hex_p/2, j*dy]) rotate(30) circle(d=hex_hole/cos(30), $fn=6);
}
module txt(s, size, y, font=caps_font, spacing=1) translate([0,y])
    text(s, size=size, font=font, halign="center", valign="center", spacing=spacing);
module wreath(y, r=10.8) translate([0,y]) {
    for (s=[-1,1]) scale([s,1]) {
        stroke([for (a=[-100:6:55]) [r*cos(a), r*sin(a)]], 0.55);
        for (a=[-85:15:50]) translate([r*cos(a), r*sin(a)]) rotate(a+125) leaf(2.3, 0.95);
        for (a=[-77:15:50]) translate([r*cos(a), r*sin(a)]) rotate(a+55) leaf(2.0, 0.85);
    }
    translate([0,-r]) blossom(1.7, 5, false);
}
module sprig(y, len=15) translate([0,y]) {
    for (s=[-1,1]) scale([s,1]) {
        stroke([[3.2,0],[3.2+len,0]], 0.55);
        for (k=[0:2]) translate([5.5 + k*4.5, 0]) { rotate(35) leaf(2.0,0.85); rotate(-35) leaf(2.0,0.85); }
        translate([3.2+len+0.6,0]) circle(d=1.0, $fn=12);
    }
    blossom(2.0, 5, false);
}

// ============================================================================
//  page geometry (view coords: looking at the INSIDE of the opened page)
// ============================================================================
X = PW/2;
module p1() translate([-X, y1a]) square([PW, P1h]);
module p2() translate([-X, y2a]) square([PW, P2h]);
module p3() hull() {
    translate([-X, y3a]) square([PW, max(P3rect, 0.01)]);
    translate(seal_c) circle(seal_r, $fn=72);
}
// the same panels continued past their folds, so offsets ignore fold edges
module p1x() translate([-X, y1a]) square([PW, P1h + 30]);
module p2x() translate([-X, y2a - 30]) square([PW, P2h + 60]);
// the flap's V edges continued past the flap's base, so an inward offset of
// this shape gives a lace strip along the V only
function vdir(sx) = let(P=[sx*X, y3r], d=seal_c - P, L=norm(d), a=-sx*asin(seal_r/L),
                        u=d/L) [u[0]*cos(a) - u[1]*sin(a), u[0]*sin(a) + u[1]*cos(a)];
module p3v() hull() {
    translate(seal_c) circle(seal_r, $fn=72);
    for (sx=[-1,1]) { translate([sx*X, y3r]) circle(0.01); translate([sx*X, y3r] - vdir(sx)*150) circle(0.01); }
}
module p3x() union() { p3(); translate([-X, y3a - 30]) square([PW, 30 + P3rect]); }

// ---------------- the lace border ----------------
// lace edges: [from, to, margin at start, margin at end, a point inside the page]
function vtan(sx) = let(P=[sx*X, y3r], L=sqrt(pow(norm(seal_c-P),2) - seal_r*seal_r)) P + vdir(sx)*L;
// distance along the V edge at which a scallop clears the medallion by 1 mm
med_gap = sqrt(pow(seal_r + sr + 1, 2) - pow(seal_r - sr, 2));
lace_edges = [
    [[-X, 0],   [X, 0],      2*rose_r, 2*rose_r, [0, 30]],                 // bottom
    [[-X, 0],   [-X, y1b],   2*rose_r, 0, [0, 40]],  [[X, 0], [X, y1b], 2*rose_r, 0, [0, 40]],
    [[-X, y2a], [-X, y2b],   0, 0, [0, y2a+40]],     [[X, y2a], [X, y2b], 0, 0, [0, y2a+40]],
    // the flap's lace stops with a whole scallop just short of the medallion
    [[-X, y3a], vtan(-1),    0, med_gap, [0, y3a+15]],     [[X, y3a], vtan(1),  0, med_gap, [0, y3a+15]]
];
corners = [[-X + rose_r, rose_r], [X - rose_r, rose_r]];

// place edge-local geometry (x along the edge, y pointing into the page)
module on_edge(e) {
    d = e[1] - e[0];  L = norm(d);  u = d/L;  n0 = [-u[1], u[0]];
    n = (n0*(e[4] - e[0]) > 0) ? n0 : -n0;
    // local frame: x -> u, y -> n  (a reflection when n = -n0, which is fine here)
    multmatrix([[u[0], n[0], 0, e[0][0] + u[0]*e[2]],
                [u[1], n[1], 0, e[0][1] + u[1]*e[2]],
                [0, 0, 1, 0], [0, 0, 0, 1]])
        children();
}
function e_len(e) = norm(e[1] - e[0]) - e[2] - e[3];

module teardrop(l, w0, w1) hull() { circle(d=w0, $fn=12); translate([l,0]) circle(d=w1, $fn=16); }

// one edge's worth of lace, in local coordinates; `mode` picks the layer
// tail = extra length past the last scallop (used where the flap lace meets the
// medallion): the edge line, net and beading continue there, scallops do not
module lace_run(L, mode, tail=0) {
    n = max(1, round(L/unit));  U = L/n;
    if (mode=="strip") translate([-0.01, -2]) square([L + tail + 0.02, sr + 2]);
    for (k=[0:n-1]) translate([U*(k+0.5), 0]) {
        if (mode=="scallop") translate([0, sr]) {
            circle(sr, $fn=48);
            for (a=[200:14:340]) translate(sr*[cos(a), sin(a)]) circle(0.62, $fn=12);   // picots
        }
        if (mode=="holes") translate([0, sr]) {
            // fan: 5 blades; every strand between holes is >= ~0.45 mm
            for (a=[210:30:330]) rotate(a) translate([1.8, 0]) teardrop(1.6, 0.45, 0.85);
            for (a=[195:30:345]) translate(4.2*[cos(a), sin(a)]) circle(d=0.72, $fn=12);
        }
        if (mode=="motifs") {
            // garland swag between two flowers, with a bud and a pair of leaves at its crest
            stroke([for (t=[0:0.1:1.001]) [U*(t-0.5), sr + 3.0 + 3.6*sin(t*180)]], 0.62);
            translate([0, sr + 6.6]) { rotate(90) leaf(2.4, 1.15); rotate(140) leaf(2.1, 0.9); rotate(40) leaf(2.1, 0.9); }
            translate([0, sr + 1.6]) circle(d=1.5, $fn=16);                                // fan pivot
            translate([0, lace_w - 3.2]) for (a=[90, 210, 330]) translate(0.75*[cos(a), sin(a)]) circle(d=0.95, $fn=12);
        }
    }
    for (k=[0:n]) translate([U*k, sr + 3.0]) {
        if (mode=="motifs") lace_blossom(2.75, 5);
        if (mode=="motif_holes") rotate(k*36) lace_blossom(2.75, 5, true);
    }
    if (mode=="net") translate([0, sr + 0.7]) square([L + tail, lace_w - 1.2 - sr - 0.7]);
    if (mode=="beads") for (x=[1.1:2.2:L + tail - 0.5]) translate([x, lace_w + 0.9]) circle(d=0.75, $fn=10);
}
module lace(mode) for (e=lace_edges) on_edge(e) lace_run(e_len(e), mode, e[3] == med_gap ? med_gap : 0);

module rosette(mode) {
    if (mode=="disc") { circle(rose_r, $fn=72); for (a=[0:15:359]) translate(rose_r*[cos(a), sin(a)]) circle(0.62, $fn=12); }
    if (mode=="holes") {
        for (a=[0:36:359]) rotate(a + 18) translate([1.9, 0]) teardrop(2.6, 0.5, 1.15);
        for (a=[0:22.5:359]) translate(6.0*[cos(a), sin(a)]) circle(d=0.8, $fn=12);
        for (a=[11.25:22.5:359]) translate(7.0*[cos(a), sin(a)]) circle(d=0.55, $fn=10);
    }
}
module rosettes(mode) for (c=corners) translate(c) rosette(mode);

module keep_off_folds() union() {
    translate([-X, y1a]) square([PW, P1h - fold_rim]);
    translate([-X, y2a + fold_rim]) square([PW, P2h - 2*fold_rim]);
    difference() { translate([-X, y3a + fold_rim]) square([PW, P3h]); translate(seal_c) circle(seal_r + 3); }
}

module sheet_outline() {
    difference() {
        union() { p1(); p2(); p3(); }
        lace("strip");
        for (c=corners) translate(c) square(2*rose_r + 0.02, center=true);
    }
    medallion("disc");
    intersection() {
        union() { lace("scallop"); rosettes("disc"); }
        union() { offset(0.7) p1(); offset(0.7) p2(); offset(0.7) p3(); }
    }
}

// ---------------- lace fields ----------------
// open-petal desert flower: 8 outer petals with open centres, 5 inner petals,
// a pierced heart. inner=true gives the openings.
module desert_flower(r, inner=false) {
    if (!inner) {
        for (a=[0:45:359]) rotate(a + 22.5) translate([r*0.55, 0]) scale([r*0.45, r*0.21]) circle(1, $fn=32);
        for (a=[0:72:359]) rotate(a) translate([r*0.28, 0]) scale([r*0.24, r*0.15]) circle(1, $fn=24);
    } else {
        for (a=[0:45:359]) rotate(a + 22.5) translate([r*0.64, 0]) scale([r*0.27, r*0.095]) circle(1, $fn=24);
        for (a=[0:72:359]) rotate(a + 36) translate([r*0.40, 0]) circle(d=0.75, $fn=10);
        circle(d=0.9, $fn=12);
    }
}
// open leaf: outline with a lens-shaped opening
module open_leaf(l, w, inner=false) { if (!inner) leaf(l, w); else translate([l*0.2, 0]) leaf(l*0.6, w - 1.3); }
// a scrolling vine that ends in a curl, with open leaves and buds along it
function curl_pts(p0, len, rise, turns, dir) = concat(
    [for (t=[0:0.05:1.001]) p0 + [dir*len*t, rise*sin(t*180)*0.6 + rise*t*0.4]],
    [for (a=[0:20:turns*360]) let(rr = 2.6*(1 - a/(turns*400)))
        p0 + [dir*len, rise] + [dir*(rr*sin(a)), rr*(1 - cos(a))*0.9 - 0.0]]);
module vine_scroll(p0, len, rise, dir, inner=false) {
    pts = curl_pts(p0, len, rise, 0.85, dir);
    if (!inner) stroke(pts, 0.7);
    for (k=[0.25, 0.55, 0.8]) let(i = floor(k*20), q = pts[i], up = (k*100) % 2 < 1 ? 1 : -1)
        translate(q) rotate(dir > 0 ? (k < 0.5 ? 70 : -60) : (k < 0.5 ? 110 : 240)) open_leaf(3.4, 2.4, inner);
    if (!inner) for (k=[0.4, 0.68]) translate(pts[floor(k*20)] + [0, 1.8]) circle(d=1.4, $fn=14);
}
// the flap: everything inside the two lace borders, above the fold
module flap_field() difference() {
    intersection() {
        offset(-(lace_w + 2.4)) p3v();
        translate([-X, y3a + 4.5]) square([PW, P3h]);
    }
    translate(seal_c) circle(seal_r + 5);
}
fc = [0, y3a + 13.5];   // centre flower on the flap
module flap_motifs(inner=false) {
    translate(fc) desert_flower(6.6, inner);
    for (d=[-1,1]) {
        vine_scroll(fc + [d*6.2, -1.8], 15, 1.5, d, inner);
        translate(fc + [d*25, -6.5]) desert_flower(3.6, inner);
        vine_scroll(fc + [d*28, -6.5], 7, 1.2, d, inner);
    }
}
// the bottom panel (envelope front): allover net with small sprigs, solid pads
// around the card slits and the snap stud
p1f = [X - lace_w - 2.4, lace_w + 2.4, y1b - fold_rim - 1.5];
module p1_field() difference() {
    translate([-p1f[0], p1f[1]]) square([2*p1f[0], p1f[2] - p1f[1]]);
    slit_pads();
    translate(stud_c) circle(5.2);
}
module sprig_at(inner=false) { lace_blossom(2.5, 5, inner); if (!inner) for (s=[-1,1]) rotate(-90 + s*35) translate([2.2, 0]) leaf(2.0, 0.9); }
module p1_motifs(inner=false) for (j=[0:4], i=[-5:5]) let(p = [i*12.5 + (j%2)*6.25, p1f[1] + 5 + j*11.5])
    if (abs(p[0]) < p1f[0] - 3 && p[1] < p1f[2] - 3 && norm(p - stud_c) > seal_r + 4.5) translate(p) rotate((i + j)*25) sprig_at(inner);

// corner slits for the paper card
module slit_pads() for (sx=[-1,1], sy=[-1,1]) {
    c = [sx*insert_w/2, insert_cy + sy*insert_h/2];
    hull() { translate(c + [-sx*(slit_d + 1.6), 0]) circle(3); translate(c + [0, -sy*(slit_d + 1.6)]) circle(3); }
}
module slits() for (sx=[-1,1], sy=[-1,1]) {
    c = [sx*insert_w/2, insert_cy + sy*insert_h/2];
    a = c + [-sx*(slit_d + 1.6), 0];  b = c + [0, -sy*(slit_d + 1.6)];
    hull() { translate(a + [sx*1.6,0]*0.0) circle(d=0.9, $fn=10); translate(b) circle(d=0.9, $fn=10); }
}

// everything cut through the sheet
module through() {
    intersection() {
        keep_off_folds();
        union() {
            difference() {
                intersection() { lace("net"); net_holes(-X, X, 0, Ytot); }
                lace("motifs");
                rosettes("disc");
            }
            lace("motif_holes");
            lace("holes");
            lace("beads");
        }
    }
    rosettes("holes");
    // full-lace flap
    difference() { intersection() { flap_field(); net_holes(-X, X, y3a, Ytot); } flap_motifs(); }
    intersection() { flap_field(); flap_motifs(true); }
    // lace front panel
    difference() { intersection() { p1_field(); net_holes(-X, X, 0, y1b); } p1_motifs(); }
    intersection() { p1_field(); p1_motifs(true); }
    medallion("holes");
    slits();
}

// raised cordonnet: a thin ridge tracing every motif and opening, printed on
// the top face (the outside of the closed envelope), like the corded outline
// of Alencon lace
cord_w = 0.55;  cord_h = 0.4;
module ring_out(w) difference() { offset(w) children(); children(); }
module ring_in(w)  difference() { children(); offset(-w) children(); }
module cordonnet() intersection() {
    sheet2d();
    union() {
        ring_out(cord_w) { lace("holes"); rosettes("holes"); medallion("holes");
                           intersection() { keep_off_folds(); lace("motif_holes"); } }
        ring_in(cord_w) intersection() { keep_off_folds(); lace("motifs"); }
        ring_in(cord_w) intersection() { flap_field(); flap_motifs(); }
        ring_out(cord_w) intersection() { flap_field(); flap_motifs(true); }
        ring_in(cord_w) intersection() { p1_field(); p1_motifs(); }
        ring_in(cord_w + 0.1) union() { lace("scallop"); rosettes("disc"); medallion("disc"); }
        translate(seal_c) difference() { circle(seal_r + 2.9, $fn=96); circle(seal_r + 2.9 - cord_w, $fn=96); }   // collar
    }
}

// lettering engraved into the inside face: small, widely spaced capitals,
// one script ampersand, a single hairline. Everything else is white space.
module lettering() offset(r=text_grow) {
    c2 = (y2a + y2b)/2;
    caps(line_top,      2.0, c2 + 21,   0.95);
    caps(upper(name_1), 3.3, c2 + 12.5, 1.25);
    txt("&",            6.5, c2 + 5,    script_font);
    caps(upper(name_2), 3.3, c2 - 2,    1.25);
    caps(line_date,     2.5, c2 - 15.5, 1.1);
    caps(line_loc,      2.0, c2 - 21.5, 0.85);
}
// evenly letter-spaced capitals: each glyph placed by its real advance width
em_k = 1.3563;   // OpenSCAD text(size=1) em width in mm, measured
function cadv(c) = let(m=[for (r=cinzel_adv) if (r[0]==c) r[1]]) len(m) > 0 ? m[0] : 0.6;
function tpos(t, size, tr, i) = i == 0 ? 0 : tpos(t, size, tr, i-1) + cadv(t[i-1])*size*em_k + tr;
module caps(t, size, y, tr) {
    w = tpos(t, size, tr, len(t)) - tr;
    for (i=[0:len(t)-1]) translate([-w/2 + tpos(t, size, tr, i), y - size*0.5])
        text(t[i], size=size, font=caps_font, valign="baseline");
}
// clean monogram: two capitals in the text face with a small script "&" between
module monogram2d(k=1) scale(k) {
    for (sx=[-1,1]) translate([sx*5.3, 0]) text(sx<0 ? initial_1 : initial_2, size=3.4, font=caps_font, halign="center", valign="center");
    translate([-0.45, -0.35]) text("&", size=3.6, font=script_font, halign="center", valign="center");
}
function upper(t) = chr([for (c=t) let(o=ord(c)) (o>=97 && o<=122) ? o-32 : o]);
module engraved() {
    lettering();
    translate([0, (y2a + y2b)/2 - 9.5]) square([12, 0.5], center=true);
}

// ============================================================================
//  3D (print coords: mirror-x of view coords, centred on the bed)
// ============================================================================
module to_print() translate([0, -Ytot/2]) mirror([1,0]) children();
// the small opening (shrink then grow by 0.02 mm) separates shapes that only
// touch at a point, so every exported layer is a clean manifold
module clean() offset(delta=0.02) offset(delta=-0.02) children();
module sheet2d() clean() difference() { sheet_outline(); through(); }

module hinges2d() {
    translate([-X + 6, y1b - 2.5]) square([PW - 12, g1 + 5]);
    translate([-X + 6, y2b - 2.5]) square([PW - 12, g2 + 5]);
}

// ============================================================================
//  LACE MEDALLION SNAP
//  The flap tip is a round openwork lace medallion (a little doily). Its
//  raised centre button carries the monogram and hides a socket; a split stud
//  on the outside of the bottom panel clicks up into it when the flap closes.
//
//    button (on flap tip)      heights above the flap's inner face
//    ┌────────────┐ 4.2  monogram raised on the button
//    │  button    │ 3.8  button top (stepped edge)
//    │  ┌──────┐  │ 3.2  socket roof
//    │  │chamb.│  │ 2.5  chamber  Ø3.9
//    │ ─┘ neck └─ │ 2.0  neck     Ø2.9  <- the stud's head snaps past this
//    │  │ bore │  │      bore     Ø3.6  (Ø4.4 lead-in at the very bottom)
//    └──┘      └──┘ 0
//              ▲  stud on the bottom panel: stem Ø2.6, head Ø3.6, split 0.7
// ============================================================================
hub_r = 6.5;  hub_top = 3.8;  relief_top = 4.2;
bore_d = 3.6;   lead_d = 4.4;   neck_d = 2.9;  neck_z = [2.0, 2.5];
chamb_d = 3.9;  chamb_z = [2.5, 3.2];
stem_d = 2.6;   stem_h = 2.6;   head_d = 3.6;  slot_w = 0.7;
// where the medallion lands on the bottom panel once both folds are closed
stud_c = [0, 2*(y1b + g1/2) - (2*(y2b + g2/2) - seal_c[1])];

module medallion(mode) translate(seal_c) {
    if (mode=="disc") { circle(seal_r, $fn=96); for (a=[0:12:359]) translate(seal_r*[cos(a), sin(a)]) circle(0.62, $fn=12); }
    if (mode=="holes") {
        for (a=[0:30:359]) rotate(a + 15) translate([hub_r + 0.8, 0]) teardrop(2.6, 0.7, 1.3);
        for (a=[0:15:359]) translate(11.7*[cos(a), sin(a)]) circle(d=0.75, $fn=12);
        circle(d=bore_d, $fn=40);
    }
}
// monogram raised on the button, drawn rotated 180 deg so it reads upright
// once the flap is folded down
module button_art() translate(seal_c) rotate(180) mirror([1,0]) {
    offset(r=0.06) monogram2d(0.6);
    difference() { circle(hub_r - 0.7); circle(hub_r - 1.15); }
}
module button3d() difference() {
    union() {
        translate([0,0,T - 0.01]) linear_extrude(3.4 - T + 0.01) translate(seal_c) circle(hub_r, $fn=72);
        translate([0,0,3.4]) linear_extrude(hub_top - 3.4) translate(seal_c) circle(hub_r - 0.45, $fn=72);
        translate([0,0,hub_top - 0.01]) linear_extrude(relief_top - hub_top + 0.01) button_art();
    }
    socket3d();
}

module socket3d() translate([seal_c[0], seal_c[1], 0]) {
    translate([0,0,-1]) cylinder(d=bore_d, h=neck_z[0] + 1, $fn=40);
    translate([0,0,-1]) cylinder(d=lead_d, h=deboss + 1, $fn=40);
    translate([0,0,neck_z[0] - 0.01]) cylinder(d=neck_d, h=neck_z[1] - neck_z[0] + 0.02, $fn=40);
    translate([0,0,chamb_z[0]]) cylinder(d=chamb_d, h=chamb_z[1] - chamb_z[0], $fn=40);
}

module stud3d() translate([stud_c[0], stud_c[1], T - 0.01]) difference() {
    union() {
        cylinder(d=stem_d, h=stem_h + 0.01, $fn=40);
        translate([0,0,stem_h]) cylinder(d1=stem_d, d2=head_d, h=0.2, $fn=40);
        translate([0,0,stem_h + 0.2]) cylinder(d1=head_d, d2=2.3, h=0.55, $fn=40);
    }
    translate([-slot_w/2, -5, stem_h - 1.2]) cube([slot_w, 10, 5]);     // split so the head can squeeze
}

if (part == "layer_seal")  to_print() button3d();
if (part == "layer_stud")  to_print() stud3d();
if (part == "layer_cord")  to_print() translate([0,0,T - 0.01]) linear_extrude(cord_h + 0.01) clean() cordonnet();
if (part == "layer_face") to_print() linear_extrude(deboss) difference() { sheet2d(); engraved(); translate(seal_c) circle(d=lead_d, $fn=40); }
if (part == "layer_main") to_print() translate([0,0,deboss - 0.02]) linear_extrude(T - deboss + 0.02) sheet2d();
if (part == "layer_hinge") to_print() linear_extrude(hinge_t) hinges2d();
if (part == "inlay") to_print() linear_extrude(deboss) intersection() { engraved(); sheet2d(); }

// ---------------- 2D views for the previews ----------------
// open: the inside of the page
if (part == "2d_inside")   sheet2d();
if (part == "2d_engraved") intersection() { engraved(); sheet2d(); }
if (part == "2d_hinges")   hinges2d();
if (part == "2d_card")     translate([0, insert_cy]) difference() {   // paper card, corners tucked
    square([insert_w, insert_h], center=true);
    for (sx=[-1,1], sy=[-1,1]) translate([sx*insert_w/2, sy*insert_h/2]) rotate(45) square(slit_d*sqrt(2), center=true);
}
// closed: seen from the front of the envelope (flap side). Folding a panel
// about a horizontal fold reflects it in y (x stays as on the inside view).
f1 = y1b + g1/2;  f2 = y2b + g2/2;
module fold(f) translate([0, 2*f]) mirror([0,1]) children();
if (part == "2d_closed_back")  p2();                          // middle panel, outside
if (part == "2d_closed_p1")    fold(f1) sheet2d_p1();
if (part == "2d_closed_p3")    fold(f2) sheet2d_p3();
if (part == "2d_closed_cord1") fold(f1) intersection() { cordonnet(); translate([-X-5, -5]) square([PW+10, y1b + 5]); }
if (part == "2d_closed_cord3") fold(f2) intersection() { cordonnet(); translate([-X-5, y3a]) square([PW+10, P3h + 5]); }
if (part == "2d_closed_button") fold(f2) translate(seal_c) circle(hub_r, $fn=72);
if (part == "2d_closed_button2") fold(f2) translate(seal_c) circle(hub_r - 0.45, $fn=72);
if (part == "2d_closed_buttonart") fold(f2) button_art();
module sheet2d_p1() intersection() { sheet2d(); translate([-X-5, -5]) square([PW+10, y1b + 5]); }
module sheet2d_p3() intersection() { sheet2d(); translate([-X-5, y3a]) square([PW+10, P3h + 5]); }

// cutaway of the snap, closed: flap tip (with seal) lying on the bottom panel
if (part == "snap_cutaway") difference() {
    union() {
        color([0.97,0.95,0.90]) translate([0,0,T]) mirror([0,0,1]) translate([-stud_c[0], -stud_c[1], 0]) linear_extrude(T) translate(stud_c) square(26, center=true);
        color([0.97,0.95,0.90]) translate([-stud_c[0], -stud_c[1], 0]) stud3d();
        // flap tip, flipped onto the panel (its inner face down on the panel's outer face)
        translate([0, 0, T]) {
            color([0.97,0.95,0.90]) translate(-seal_c) difference() { linear_extrude(T) translate(seal_c) square(26, center=true); socket3d(); }
            color([0.60,0.29,0.23]) translate([-seal_c[0], -seal_c[1], 0]) seal3d();
        }
    }
    translate([-20, 0, -5]) cube([40, 20, 20]);
}
